<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#8b5a35">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/images/LOGO TBA.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/output.css">
</head>
<body class="bg-brand-50 font-sans text-stone-900 antialiased">
  <%- include('partials/header') %>

  <main>
    <section class="py-8 md:py-12">
      <div class="mx-auto w-[min(100%-1.5rem,1180px)]">
        <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
          <div class="space-y-4">
            <div class="overflow-hidden rounded-[30px] bg-[#8B5A35] shadow-[0_24px_60px_rgba(139,90,53,0.2)]">
              <div class="flex h-[340px] items-center justify-center text-7xl text-white sm:h-[420px]">
                <%= getIcon(umkm.bidang) %>
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <% gallery.forEach(function(item) { %>
                <article class="overflow-hidden rounded-[24px] bg-white shadow-soft">
                  <div class="flex h-52 items-center justify-center bg-[#E8DBCF] text-5xl text-brand-700">
                    <%= item.icon %>
                  </div>
                  <div class="border-t border-brand-500/10 bg-white px-4 py-3 text-center text-xs font-medium text-stone-700"><%= item.label %></div>
                </article>
              <% }); %>
            </div>
          </div>

          <aside class="lg:sticky lg:top-24">
            <div class="rounded-[32px] border border-brand-500/10 bg-white/90 p-6 shadow-soft md:p-8">
              <span class="inline-flex rounded-full bg-brand-500/10 px-4 py-2 text-sm font-bold text-brand-700"><%= umkm.bidang %></span>
              <h1 class="mt-4 font-display text-4xl font-black leading-tight tracking-[-0.03em] text-stone-900 sm:text-5xl"><%= umkm.nama %></h1>
              <p class="mt-2 flex items-center gap-2 text-sm text-stone-500">
                <span class="text-base">👤</span>
                <%= umkm.pemilik %>
              </p>

              <p class="mt-5 max-w-2xl leading-8 text-stone-600"><%= umkm.deskripsi %></p>

              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div class="rounded-[20px] bg-brand-50 p-4">
                  <span class="block text-xs font-semibold uppercase tracking-wide text-stone-400">Tahun Berdiri</span>
                  <strong class="mt-1 block text-base text-stone-900"><%= umkm.tahun || 'Belum tersedia' %></strong>
                </div>
                <div class="rounded-[20px] bg-brand-50 p-4">
                  <span class="block text-xs font-semibold uppercase tracking-wide text-stone-400">Kisaran Harga</span>
                  <strong class="mt-1 block text-base text-stone-900">Rp <%= formatRupiah(umkm.hargaDari) %><% if (umkm.hargaSampai) { %> - Rp <%= formatRupiah(umkm.hargaSampai) %><% } %></strong>
                </div>
                <div class="rounded-[20px] bg-brand-50 p-4">
                  <span class="block text-xs font-semibold uppercase tracking-wide text-stone-400">Pemasaran</span>
                  <strong class="mt-1 block text-base text-stone-900"><%= umkm.bidang.includes('Kerajinan') ? 'Offline, Toko Fisik' : 'Offline, Pesanan Langsung' %></strong>
                </div>
                <div class="rounded-[20px] bg-brand-50 p-4">
                  <span class="block text-xs font-semibold uppercase tracking-wide text-stone-400">Status Website</span>
                  <strong class="mt-1 block text-base text-emerald-600">Bersedia</strong>
                </div>
              </div>

              <div class="mt-6 flex flex-wrap gap-3">
                <a class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-stone-700 shadow-soft" href="#produk">Produk</a>
                <a class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-stone-700 shadow-soft" href="#dokumentasi">Dokumentasi</a>
                <a class="inline-flex items-center gap-2 rounded-full bg-brand-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand-500/20 transition hover:bg-brand-600" href="/umkm">Kembali ke UMKM</a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section id="produk" class="bg-white py-14 md:py-20">
      <div class="mx-auto w-[min(100%-1.5rem,1180px)]">
        <div class="flex flex-col gap-3">
          <span class="inline-flex w-fit rounded-full bg-brand-500/10 px-4 py-2 text-sm font-bold text-brand-700">Produk & Menu</span>
          <h2 class="font-display text-3xl font-bold text-stone-900 sm:text-4xl">Produk unggulan: <%= products[0].nama %></h2>
          <p class="max-w-2xl text-stone-500">Beberapa pilihan produk yang tersedia pada usaha ini.</p>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <% products.forEach(function(product) { %>
            <article class="rounded-[22px] border border-brand-500/10 bg-[#FFFDF9] p-5 shadow-soft transition duration-200 hover:-translate-y-1">
              <div class="flex h-16 items-center justify-center text-4xl">🍽️</div>
              <h3 class="mt-3 text-center font-semibold text-stone-900"><%= product.nama %></h3>
              <p class="mt-1 text-center text-sm text-brand-700"><%= product.harga %></p>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <section id="dokumentasi" class="py-14 md:py-20">
      <div class="mx-auto w-[min(100%-1.5rem,1180px)]">
        <div class="flex flex-col gap-3">
          <span class="inline-flex w-fit rounded-full bg-brand-500/10 px-4 py-2 text-sm font-bold text-brand-700">Dokumentasi</span>
          <p class="text-stone-500">Galeri foto dari usaha ini</p>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <% gallery.forEach(function(item) { %>
            <article class="overflow-hidden rounded-[22px] bg-white shadow-soft">
              <div class="flex h-56 items-center justify-center bg-[#E8DBCF] text-5xl text-brand-700"><%= item.icon %></div>
              <div class="border-t border-brand-500/10 px-4 py-3 text-center text-sm text-stone-600"><%= item.label %></div>
            </article>
          <% }); %>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>