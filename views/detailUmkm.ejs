<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#8b5a35">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/images/LOGO TBA.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/output.css">
</head>
<body class="bg-brand-50 font-sans text-stone-900 antialiased selection:bg-brand-500 selection:text-white">
  <%- include('partials/header') %>

  <main class="py-6 md:py-10">
    <div class="mx-auto w-[min(100%-1.5rem,1180px)]">

      <!-- Main Overview Grid (Hero Visual + Profile Card) -->
      <div class="grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-start">
        
        <!-- Left: Visual Showcase & Highlights -->
        <div class="space-y-5">
          <!-- Main Hero Showcase Card -->
          <div class="relative overflow-hidden rounded-[32px] border border-brand-500/15 bg-gradient-to-br from-brand-700 via-brand-600 to-brand-800 p-6 sm:p-8 text-white shadow-[0_20px_50px_rgba(139,90,53,0.25)]">
            <!-- Background decorative pattern / blur -->
            <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/10 blur-2xl"></div>
            <div class="pointer-events-none absolute -bottom-16 -left-16 h-64 w-64 rounded-full bg-brand-900/30 blur-2xl"></div>
            
            <!-- Top Badges -->
            <div class="relative z-10 flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3.5 py-1.5 text-xs font-semibold text-white backdrop-blur-md">
                <span class="h-2 w-2 rounded-full <%= umkm.tahunBerdiri === 'BELUM DIPASARKAN' ? 'bg-amber-400' : 'bg-emerald-400' %> animate-pulse"></span>
                <%= umkm.tahunBerdiri === 'BELUM DIPASARKAN' ? 'Persiapan Legalitas' : 'UMKM Aktif' %>
              </span>
              <span class="rounded-full bg-black/25 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-white backdrop-blur-md">
                <%= umkm.badge || (umkm.bidang ? umkm.bidang.split(' ')[0] : 'UMKM') %>
              </span>
            </div>

            <!-- Central Visual / Photo Display Slot -->
            <div class="relative z-10 my-6 flex items-center justify-center">
              <% if (umkm.fotoUtama) { %>
                <div class="group relative w-full aspect-[16/10] sm:aspect-[16/9] max-h-64 overflow-hidden rounded-2xl border-2 border-white/30 bg-black/20 shadow-2xl backdrop-blur-sm transition duration-500 hover:scale-[1.02]">
                  <img src="<%= umkm.fotoUtama %>" alt="Foto <%= umkm.nama %>" class="h-full w-full object-cover object-center transition duration-500 group-hover:scale-105" onerror="this.parentElement.innerHTML='<div class=\'flex h-full w-full items-center justify-center text-7xl bg-white/10 rounded-2xl\'><%= getIcon(umkm.bidang) %></div>'">
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60"></div>
                  <span class="absolute bottom-3 left-3 rounded-full bg-black/40 backdrop-blur-md px-2.5 py-1 text-[11px] font-semibold text-white">
                    📸 Foto Profil Usaha
                  </span>
                </div>
              <% } else { %>
                <div class="relative flex h-44 w-44 sm:h-52 sm:w-52 items-center justify-center rounded-3xl bg-white/15 border border-white/25 shadow-inner backdrop-blur-md transition duration-500 hover:scale-105">
                  <span class="text-7xl sm:text-8xl drop-shadow-md"><%= getIcon(umkm.bidang) %></span>
                </div>
              <% } %>
            </div>

            <!-- Bottom Information Bar on Hero Card -->
            <div class="relative z-10 rounded-2xl bg-white/10 p-4 backdrop-blur-md border border-white/10">
              <div class="flex items-center justify-between text-xs sm:text-sm">
                <div class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-brand-200 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="text-brand-100 truncate"><%= umkm.alamat ? umkm.alamat : 'Nagari Tanjung Bonai Aur' %></span>
                </div>
                <span class="font-semibold text-white flex-shrink-0">Kab. Sijunjung</span>
              </div>
            </div>
          </div>

          <!-- Quick Navigation / Jump Links Card -->
          <div class="grid grid-cols-2 gap-4">
            <a href="#produk" class="group flex items-center justify-between rounded-2xl border border-brand-500/10 bg-white/85 p-4 shadow-sm transition hover:border-brand-500/30 hover:bg-white hover:shadow-soft">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/10 text-brand-700 group-hover:bg-brand-500 group-hover:text-white transition">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                </div>
                <div>
                  <span class="block text-xs text-stone-400 font-medium">Katalog</span>
                  <strong class="block text-sm text-stone-800">Daftar Produk</strong>
                </div>
              </div>
              <svg class="h-4 w-4 text-stone-400 group-hover:text-brand-700 group-hover:translate-x-0.5 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <a href="#dokumentasi" class="group flex items-center justify-between rounded-2xl border border-brand-500/10 bg-white/85 p-4 shadow-sm transition hover:border-brand-500/30 hover:bg-white hover:shadow-soft">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/10 text-brand-700 group-hover:bg-brand-500 group-hover:text-white transition">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <span class="block text-xs text-stone-400 font-medium">Galeri</span>
                  <strong class="block text-sm text-stone-800">Dokumentasi</strong>
                </div>
              </div>
              <svg class="h-4 w-4 text-stone-400 group-hover:text-brand-700 group-hover:translate-x-0.5 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          <!-- Media Sosial Bar (Jika ada) -->
          <% if (umkm.sosialMedia && (umkm.sosialMedia.facebook || umkm.sosialMedia.instagram || umkm.sosialMedia.tiktok)) { %>
            <div class="rounded-2xl border border-brand-500/10 bg-white/90 p-4 shadow-sm">
              <span class="block text-[11px] font-bold uppercase tracking-wider text-stone-400 mb-2">Media Sosial Resmi:</span>
              <div class="flex flex-wrap items-center gap-2">
                <% if (umkm.sosialMedia.instagram) { %>
                  <a href="<%= umkm.sosialMedia.instagram.startsWith('http') ? umkm.sosialMedia.instagram : 'https://instagram.com/' + umkm.sosialMedia.instagram %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-pink-50 border border-pink-200/60 px-3 py-1.5 text-xs font-semibold text-pink-700 transition hover:bg-pink-100">
                    <span>📷 Instagram</span>
                  </a>
                <% } %>
                <% if (umkm.sosialMedia.facebook) { %>
                  <a href="<%= umkm.sosialMedia.facebook.startsWith('http') ? umkm.sosialMedia.facebook : 'https://facebook.com/' + umkm.sosialMedia.facebook %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 border border-blue-200/60 px-3 py-1.5 text-xs font-semibold text-blue-700 transition hover:bg-blue-100">
                    <span>📘 Facebook</span>
                  </a>
                <% } %>
                <% if (umkm.sosialMedia.tiktok) { %>
                  <a href="<%= umkm.sosialMedia.tiktok.startsWith('http') ? umkm.sosialMedia.tiktok : 'https://tiktok.com/' + umkm.sosialMedia.tiktok %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-stone-100 border border-stone-300/60 px-3 py-1.5 text-xs font-semibold text-stone-800 transition hover:bg-stone-200">
                    <span>🎵 TikTok</span>
                  </a>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>

        <!-- Right: Business Profile Info Details -->
        <div class="rounded-[32px] border border-brand-500/15 bg-white/95 p-6 shadow-soft md:p-8">
          
          <!-- Category & Status Badge -->
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-500/10 px-3.5 py-1.5 text-xs font-bold text-brand-700">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
              <%= umkm.bidang ? umkm.bidang : 'Usaha Nagari' %>
            </span>

            <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-600 bg-emerald-50 border border-emerald-200/60 rounded-full px-3 py-1">
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              Terdaftar di Nagari
            </span>
          </div>

          <!-- Business Name & Owner -->
          <h1 class="mt-4 font-display text-3xl font-black leading-tight tracking-[-0.03em] text-stone-900 sm:text-4xl lg:text-5xl">
            <%= umkm.nama %>
          </h1>

          <div class="mt-3 flex items-center gap-2 text-stone-600">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-500/10 text-brand-700">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div>
              <span class="block text-[11px] font-medium text-stone-400 leading-none">Pemilik Usaha</span>
              <strong class="text-sm font-semibold text-stone-800"><%= umkm.pemilik ? umkm.pemilik : 'Belum tercatat' %></strong>
            </div>
          </div>

          <!-- Description -->
          <div class="mt-5 rounded-2xl bg-brand-50/50 p-4 border border-brand-500/10">
            <h3 class="text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">Tentang Usaha</h3>
            <p class="text-sm sm:text-base leading-relaxed text-stone-600">
              <%= umkm.deskripsi ? umkm.deskripsi : 'Informasi profil dan deskripsi detail usaha ini sedang dalam proses pembaruan data nagari.' %>
            </p>
          </div>

          <!-- Detail Specs Grid (2x2) -->
          <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <!-- Tahun Berdiri -->
            <div class="flex items-start gap-3 rounded-2xl border border-brand-500/10 bg-white p-4 shadow-sm">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-amber-500/10 text-amber-700">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="block text-[11px] font-bold uppercase tracking-wider text-stone-400">Tahun Berdiri</span>
                <strong class="mt-0.5 block text-sm font-bold text-stone-900">
                  <%= umkm.tahunBerdiri ? umkm.tahunBerdiri : (umkm.tahun ? umkm.tahun : 'Belum Tersedia') %>
                </strong>
              </div>
            </div>

            <!-- Kisaran Harga -->
            <div class="flex items-start gap-3 rounded-2xl border border-brand-500/10 bg-white p-4 shadow-sm">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-700">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <span class="block text-[11px] font-bold uppercase tracking-wider text-stone-400">Kisaran Harga</span>
                <strong class="mt-0.5 block text-sm font-bold text-brand-700">
                  <% if (umkm.hargaDisplay) { %>
                    <%= umkm.hargaDisplay %>
                  <% } else if (umkm.hargaDari) { %>
                    Rp <%= formatRupiah(umkm.hargaDari) %><% if (umkm.hargaSampai) { %> - <%= formatRupiah(umkm.hargaSampai) %><% } %>
                  <% } else { %>
                    Sesuai Pesanan
                  <% } %>
                </strong>
              </div>
            </div>

            <!-- Jam Operasional -->
            <div class="flex items-start gap-3 rounded-2xl border border-brand-500/10 bg-white p-4 shadow-sm">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-blue-500/10 text-blue-700">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <span class="block text-[11px] font-bold uppercase tracking-wider text-stone-400">Jam Operasional</span>
                <strong class="mt-0.5 block text-sm font-bold text-stone-900">
                  <%= umkm.jamOperasional ? umkm.jamOperasional : 'Fleksibel' %>
                </strong>
              </div>
            </div>

            <!-- Model Pemasaran -->
            <div class="flex items-start gap-3 rounded-2xl border border-brand-500/10 bg-white p-4 shadow-sm">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-purple-500/10 text-purple-700">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <div>
                <span class="block text-[11px] font-bold uppercase tracking-wider text-stone-400">Saluran Pemasaran</span>
                <strong class="mt-0.5 block text-sm font-bold text-stone-900">
                  <%= umkm.pemasaran ? umkm.pemasaran : (umkm.bidang && umkm.bidang.includes('Kerajinan') ? 'Offline & Toko Fisik' : 'Offline & Pesanan Langsung') %>
                </strong>
              </div>
            </div>
          </div>

          <!-- Highlight Produk Paling Diminati (Jika ada) -->
          <% if (umkm.produkDiminati) { %>
            <div class="mt-4 flex items-center gap-3 rounded-2xl bg-amber-500/10 border border-amber-500/20 p-3.5">
              <span class="text-2xl">⭐</span>
              <div>
                <span class="block text-[11px] font-bold uppercase tracking-wider text-amber-800">Produk Paling Diminati</span>
                <strong class="text-sm font-bold text-stone-900"><%= umkm.produkDiminati %></strong>
              </div>
            </div>
          <% } %>

          <!-- Action Buttons / CTA -->
          <div class="mt-6 pt-5 border-t border-stone-100 flex flex-col sm:flex-row gap-3">
            <% const waNumber = umkm.whatsapp ? umkm.whatsapp.replace(/[^0-9]/g, '') : ''; %>
            <% if (waNumber) { %>
              <a href="https://wa.me/<%= waNumber %>?text=<%= encodeURIComponent('Halo, saya tertarik untuk memesan / menanyakan produk ' + umkm.nama + ' di Nagari Tanjung Bonai Aur.') %>" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full bg-brand-500 px-6 py-3 font-semibold text-white shadow-lg shadow-brand-500/20 transition hover:bg-brand-600 hover:-translate-y-0.5">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/>
                </svg>
                <span>Hubungi / Pesan via WhatsApp</span>
              </a>
            <% } else { %>
              <a href="https://wa.me/?text=<%= encodeURIComponent('Halo, saya tertarik dengan informasi UMKM ' + umkm.nama + ' di Nagari Tanjung Bonai Aur.') %>" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full bg-brand-500 px-6 py-3 font-semibold text-white shadow-lg shadow-brand-500/20 transition hover:bg-brand-600 hover:-translate-y-0.5">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/>
                </svg>
                <span>Hubungi Pengelola Usaha</span>
              </a>
            <% } %>
            
            <a href="/umkm" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-brand-500/25 bg-brand-50/60 px-6 py-3 font-semibold text-brand-700 transition hover:bg-brand-50 hover:-translate-y-0.5">
              <span>Lihat UMKM Lainnya</span>
            </a>
          </div>

        </div>

      </div>

      <!-- SECTION: DAFTAR PRODUK & VARIAN -->
      <section id="produk" class="mt-14 scroll-mt-24 rounded-[32px] border border-brand-500/10 bg-white p-6 shadow-soft sm:p-10">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 border-b border-stone-100 pb-6">
          <div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-500/10 px-3.5 py-1.5 text-xs font-bold text-brand-700">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              Katalog Produk &amp; Layanan
            </span>
            <h2 class="mt-3 font-display text-2xl font-bold text-stone-900 sm:text-3xl lg:text-4xl">
              Varian Produk dari <%= umkm.nama %>
            </h2>
            <p class="mt-1 text-sm text-stone-500">
              <%= umkm.produkUtama ? 'Pilihan produk utama: ' + umkm.produkUtama : 'Pilihan menu dan jenis produk yang dapat dipesan langsung oleh pelanggan.' %>
            </p>
          </div>
          <span class="text-xs font-semibold text-stone-400 bg-stone-50 border border-stone-200/60 rounded-full px-3 py-1.5 self-start sm:self-auto">
            <%= products.length %> Pilihan Tersedia
          </span>
        </div>

        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          <% products.forEach(function(product, idx) { %>
            <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-brand-500/10 bg-[#FFFDF9] p-5 shadow-sm transition duration-300 hover:-translate-y-1.5 hover:border-brand-500/30 hover:shadow-soft">
              <div>
                <!-- Top Badge on product card -->
                <div class="flex items-center justify-between">
                  <span class="rounded-full bg-brand-500/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-brand-700">
                    <%= product.tag || (idx === 0 ? 'Unggulan' : (idx === 1 ? 'Populer' : 'Pilihan')) %>
                  </span>
                  <span class="inline-flex items-center text-[10px] font-semibold text-emerald-600">
                    <span class="mr-1 h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                    Tersedia
                  </span>
                </div>

                <!-- Product Photo Slot / Illustration -->
                <div class="my-4 flex h-32 sm:h-36 w-full items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-brand-100/60 to-brand-50/40 text-4xl transition group-hover:scale-105 duration-300">
                  <% if (product.foto) { %>
                    <img src="<%= product.foto %>" alt="<%= product.nama %>" class="h-full w-full object-cover object-center transition duration-300" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <span class="hidden"><%= umkm.bidang && umkm.bidang.includes('Kerajinan') ? (idx % 2 === 0 ? '🧵' : '✨') : (idx % 2 === 0 ? '🍲' : '🍱') %></span>
                  <% } else { %>
                    <span><%= umkm.bidang && umkm.bidang.includes('Kerajinan') ? (idx % 2 === 0 ? '🧵' : '✨') : (idx % 2 === 0 ? '🍲' : '🍱') %></span>
                  <% } %>
                </div>

                <!-- Product Info -->
                <h3 class="font-display text-base font-bold text-stone-900 group-hover:text-brand-700 transition">
                  <%= product.nama %>
                </h3>
                <p class="mt-1 text-xs text-stone-500">
                  Produk asli buatan <%= umkm.nama %>, Nagari Tanjung Bonai Aur.
                </p>
              </div>

              <!-- Product Price & Action -->
              <div class="mt-5 border-t border-brand-500/10 pt-3 flex items-center justify-between">
                <div>
                  <span class="block text-[10px] uppercase font-semibold text-stone-400">Harga</span>
                  <strong class="text-sm font-black text-brand-700">
                    <% if (product.harga && (product.harga.includes('Rp') || product.harga === 'Custom' || product.harga.includes('Pesanan') || product.harga.includes('Pasar') || product.harga.includes('Warung') || product.harga.includes('Mulai'))) { %>
                      <%= product.harga %>
                    <% } else if (product.harga) { %>
                      Rp <%= product.harga %>
                    <% } else { %>
                      Sesuai Pesanan
                    <% } %>
                  </strong>
                </div>
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-50 text-brand-700 group-hover:bg-brand-500 group-hover:text-white transition">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                </span>
              </div>
            </article>
          <% }); %>
        </div>
      </section>

      <!-- SECTION: DOKUMENTASI & GALERI FOTO -->
      <section id="dokumentasi" class="mt-14 scroll-mt-24 rounded-[32px] border border-brand-500/10 bg-white p-6 shadow-soft sm:p-10">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 border-b border-stone-100 pb-6">
          <div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-500/10 px-3.5 py-1.5 text-xs font-bold text-brand-700">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Galeri &amp; Dokumentasi
            </span>
            <h2 class="mt-3 font-display text-2xl font-bold text-stone-900 sm:text-3xl lg:text-4xl">
              Dokumentasi Kegiatan &amp; Usaha
            </h2>
            <p class="mt-1 text-sm text-stone-500">
              Potret aktivitas, tempat usaha, dan proses kerja pelaku UMKM di Nagari Tanjung Bonai Aur
            </p>
          </div>
          <span class="text-xs font-semibold text-brand-700 bg-brand-500/10 border border-brand-500/20 rounded-full px-3.5 py-1.5 self-start sm:self-auto">
            <%= gallery.length %> Dokumentasi Tersedia
          </span>
        </div>

        <!-- Gallery Grid Slot -->
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% gallery.forEach(function(item, index) { %>
            <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-brand-500/15 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-brand-500/35 hover:shadow-soft cursor-pointer gallery-card" data-full-img="<%= item.url || '' %>" data-title="<%= item.label %>" data-desc="<%= item.deskripsi || ('Dokumentasi resmi aktivitas usaha ' + umkm.nama + ' di Nagari Tanjung Bonai Aur.') %>">
              
              <!-- Photo Container Slot -->
              <div class="relative w-full aspect-[4/3] overflow-hidden bg-gradient-to-br from-[#EFE5DB] to-[#E3D3C4] flex items-center justify-center">
                <% if (item.url) { %>
                  <img src="<%= item.url %>" alt="<%= item.label %>" class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                  <span class="hidden text-5xl"><%= item.icon || '📸' %></span>
                <% } else { %>
                  <span class="text-5xl drop-shadow-sm transition duration-300 group-hover:scale-110"><%= item.icon || '📸' %></span>
                <% } %>
                
                <!-- Badge index -->
                <span class="absolute top-3 left-3 rounded-full bg-black/40 backdrop-blur-md px-2.5 py-1 text-[11px] font-bold text-white uppercase border border-white/20">
                  Foto 0<%= index + 1 %>
                </span>

                <!-- Hover Overlay with Zoom Icon (if url exists) -->
                <% if (item.url) { %>
                  <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-white/90 px-3.5 py-1.5 text-xs font-bold text-stone-900 shadow-md backdrop-blur-sm">
                      <svg class="h-3.5 w-3.5 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                      </svg>
                      Perbesar
                    </span>
                  </div>
                <% } %>
              </div>

              <!-- Card Content / Caption -->
              <div class="flex flex-col justify-between flex-grow p-4 bg-white border-t border-brand-500/10">
                <div>
                  <strong class="block text-sm font-bold text-stone-900 group-hover:text-brand-700 transition">
                    <%= item.label %>
                  </strong>
                  <p class="mt-1 text-xs text-stone-500 line-clamp-2 leading-relaxed">
                    <%= item.deskripsi || ('Dokumentasi resmi aktivitas usaha ' + umkm.nama + ' di Nagari Tanjung Bonai Aur.') %>
                  </p>
                </div>
                <div class="mt-3 pt-2.5 border-t border-stone-100 flex items-center justify-between text-[11px] text-stone-400">
                  <span class="font-medium text-brand-700"><%= umkm.nama %></span>
                  <span class="font-semibold text-brand-600"><%= item.url ? 'Lihat Foto ↗' : 'Belum Ada Foto' %></span>
                </div>
              </div>
            </article>
          <% }); %>
        </div>
      </section>

      <!-- SECTION: INFORMASI LOKASI & DUKUNGAN UMKM -->
      <section class="mt-14 rounded-[32px] border border-brand-500/10 bg-gradient-to-br from-white/95 to-brand-50/80 p-6 shadow-soft sm:p-10">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
          <div class="max-w-2xl">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-500/10 px-3.5 py-1.5 text-xs font-bold text-brand-700">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Informasi Lokasi &amp; Wilayah
            </span>
            <h3 class="mt-3 font-display text-2xl font-bold text-stone-900 sm:text-3xl">
              Dukung Perkembangan Usaha Lokal <%= umkm.nama %>
            </h3>
            <p class="mt-2 text-sm sm:text-base leading-relaxed text-stone-600">
              Usaha ini berlokasi di <strong><%= umkm.alamat ? umkm.alamat : 'Nagari Tanjung Bonai Aur' %></strong>, Kecamatan Sumpur Kudus, Kabupaten Sijunjung, Sumatera Barat. Dikelola langsung oleh <strong><%= umkm.pemilik ? umkm.pemilik : 'Pelaku Usaha Lokal' %></strong> untuk menggerakkan perekonomian masyarakat nagari.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <a href="/umkm" class="inline-flex min-h-12 items-center justify-center rounded-full bg-brand-500 px-6 py-3 font-semibold text-white shadow-lg shadow-brand-500/20 transition hover:bg-brand-600 hover:-translate-y-0.5">
              Jelajahi UMKM Lainnya
            </a>
            <a href="/tentang" class="inline-flex min-h-12 items-center justify-center rounded-full border border-brand-500/25 bg-white px-6 py-3 font-semibold text-brand-700 transition hover:bg-brand-50 hover:-translate-y-0.5">
              Tentang Website
            </a>
          </div>
        </div>
      </section>

    </div>
  </main>

  <!-- Lightbox Modal for Gallery Images -->
  <div id="galleryLightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm transition-opacity duration-300 opacity-0" aria-hidden="true">
    <div class="relative max-h-[90vh] max-w-4xl w-full flex flex-col items-center">
      <!-- Close Button -->
      <button id="closeLightbox" type="button" class="absolute -top-12 right-0 flex h-10 w-10 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur-md transition hover:bg-white/40 cursor-pointer" aria-label="Tutup foto">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Lightbox Image -->
      <div class="overflow-hidden rounded-2xl border border-white/20 bg-stone-950 shadow-2xl max-h-[75vh] flex items-center justify-center">
        <img id="lightboxImg" src="" alt="Preview Dokumentasi" class="max-h-[75vh] w-auto max-w-full object-contain">
      </div>

      <!-- Lightbox Caption -->
      <div class="mt-3 text-center text-white">
        <h4 id="lightboxTitle" class="text-base font-bold"></h4>
        <p id="lightboxDesc" class="mt-0.5 text-xs text-stone-300"></p>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <!-- Script for Mobile Navigation Toggle & Lightbox -->
  <script>
    const navToggle = document.querySelector('[data-nav-toggle]');
    const mobileNav = document.querySelector('[data-mobile-nav]');

    if (navToggle && mobileNav) {
      navToggle.addEventListener('click', () => {
        const isHidden = mobileNav.classList.contains('hidden');
        mobileNav.classList.toggle('hidden');
        navToggle.setAttribute('aria-expanded', String(isHidden));
      });

      mobileNav.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          mobileNav.classList.add('hidden');
          navToggle.setAttribute('aria-expanded', 'false');
        });
      });
    }

    // Lightbox Functionality
    const galleryCards = document.querySelectorAll('.gallery-card');
    const lightbox = document.getElementById('galleryLightbox');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxTitle = document.getElementById('lightboxTitle');
    const lightboxDesc = document.getElementById('lightboxDesc');
    const closeLightboxBtn = document.getElementById('closeLightbox');

    if (galleryCards.length && lightbox && lightboxImg) {
      galleryCards.forEach(card => {
        card.addEventListener('click', () => {
          const imgUrl = card.dataset.fullImg;
          if (!imgUrl) return;

          lightboxImg.src = imgUrl;
          lightboxTitle.textContent = card.dataset.title || '';
          lightboxDesc.textContent = card.dataset.desc || '';

          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
          setTimeout(() => {
            lightbox.classList.remove('opacity-0');
            lightbox.classList.add('opacity-100');
          }, 10);
          document.body.style.overflow = 'hidden';
        });
      });

      function hideLightbox() {
        lightbox.classList.remove('opacity-100');
        lightbox.classList.add('opacity-0');
        setTimeout(() => {
          lightbox.classList.add('hidden');
          lightbox.classList.remove('flex');
          lightboxImg.src = '';
          document.body.style.overflow = '';
        }, 250);
      }

      if (closeLightboxBtn) {
        closeLightboxBtn.addEventListener('click', hideLightbox);
      }
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) hideLightbox();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
          hideLightbox();
        }
      });
    }
  </script>
</body>
</html>