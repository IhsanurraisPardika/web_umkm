<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#8b5a35">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/images/LOGO TBA.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/output.css">
</head>
<body class="bg-brand-50 font-sans text-stone-900 antialiased">
  <%- include('partials/header') %>

  <!-- ===== MAIN CONTENT ===== -->
  <main>
    <!-- HERO -->
    <section id="beranda" class="relative overflow-hidden py-14 md:py-20">
      <div class="absolute inset-x-0 top-0 -z-10 h-[620px] bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.96),transparent_34%),radial-gradient(circle_at_85%_18%,rgba(139,90,53,0.14),transparent_25%)]"></div>
      <div class="mx-auto grid w-[min(100%-1.5rem,1180px)] items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
        <div>
          <span class="inline-flex items-center rounded-full bg-brand-500/10 px-4 py-2 text-sm font-bold tracking-wide text-brand-700">Katalog UMKM lokal terbaik</span>
          <h1 class="mt-5 max-w-[12ch] font-display text-5xl font-black leading-[0.95] tracking-[-0.04em] text-stone-900 sm:text-6xl lg:text-[5.25rem]">Ragam UMKM Nagari Tanjung Bonai Aur</h1>
          <p class="mt-5 max-w-2xl text-base leading-8 text-stone-600 sm:text-lg">Temukan kerajinan tangan, kuliner khas, dan produk berkualitas dari para pelaku usaha lokal dalam satu tampilan yang modern, cepat, dan nyaman di semua ukuran layar.</p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a class="inline-flex min-h-12 items-center justify-center rounded-full bg-brand-500 px-6 py-3 font-semibold text-white shadow-lg shadow-brand-500/20 transition hover:-translate-y-0.5 hover:bg-brand-600" href="/umkm">Lihat UMKM</a>
              <a class="inline-flex min-h-12 items-center justify-center rounded-full border border-brand-500/25 bg-white/70 px-6 py-3 font-semibold text-brand-700 transition hover:-translate-y-0.5 hover:bg-brand-50" href="/tentang">Jelajahi</a>
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-3">
            <span class="font-semibold text-brand-700">Daftarkan UMKM anda!</span>
              <a class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-600 px-5 py-2.5 font-semibold text-white shadow-lg shadow-brand-500/20 transition hover:bg-brand-700" href="/tentang">Daftar disini</a>
          </div>
        </div>

        <div class="relative flex min-h-[360px] items-center justify-center lg:min-h-[560px]">
          <div class="relative aspect-square w-full max-w-[560px] overflow-hidden rounded-full border-[8px] border-white bg-white shadow-[0_30px_80px_rgba(139,90,53,0.18)]">
            <img src="/images/TBA.jpg" alt="Foto TBA UMKM" class="h-full w-full object-cover object-center">
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="py-6 md:py-10">
      <div class="mx-auto grid w-[min(100%-1.5rem,1180px)] gap-4 rounded-[32px] bg-white/75 p-5 shadow-soft sm:grid-cols-2 lg:grid-cols-4 lg:p-6">
        <% stats.forEach(function(item) { %>
          <article class="rounded-3xl px-4 py-6 text-center">
            <strong class="block font-display text-5xl leading-none text-brand-500 sm:text-6xl"><%= item.value %></strong>
            <span class="mt-2 block text-sm font-medium text-stone-500"><%= item.label %></span>
          </article>
        <% }); %>
      </div>
    </section>

    <!-- CATEGORIES -->
    <section class="py-14 md:py-20">
      <div class="mx-auto mb-7 flex w-[min(100%-1.5rem,1180px)] flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <span class="inline-flex rounded-full bg-brand-500/10 px-4 py-2 text-sm font-bold text-brand-700">Kategori Usaha</span>
          <h2 class="mt-4 max-w-3xl font-display text-3xl font-bold leading-tight tracking-[-0.03em] text-stone-900 sm:text-4xl lg:text-5xl">Beragam bidang usaha dari para pelaku UMKM</h2>
        </div>
        <p class="max-w-xl leading-8 text-stone-600"></p>
      </div>

      <div class="mx-auto grid w-[min(100%-1.5rem,1180px)] gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <% categories.forEach(function(item, index) { %>
          <article class="rounded-[24px] border border-brand-500/10 bg-white/85 p-7 shadow-card transition duration-200 hover:-translate-y-1 hover:shadow-soft">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-500/10 text-2xl"><%= item.icon %></span>
            <h3 class="mt-5 text-xl font-bold text-stone-900"><%= item.title %></h3>
            <p class="mt-2 leading-7 text-stone-600"><%= item.text %></p>
          </article>
        <% }); %>
      </div>
    </section>

    <!-- CTA -->
      <section class="py-14 md:py-20">
      <div class="mx-auto w-[min(100%-1.5rem,1180px)] rounded-[32px] border border-brand-500/10 bg-gradient-to-br from-white/90 to-brand-50/80 p-7 shadow-soft md:p-10">
        <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-center">
          <div>
            <span class="inline-flex rounded-full bg-brand-500/10 px-4 py-2 text-sm font-bold text-brand-700">Dukung UMKM Lokal</span>
            <h2 class="mt-4 max-w-3xl font-display text-3xl font-bold leading-tight tracking-[-0.03em] text-stone-900 sm:text-4xl lg:text-5xl">Setiap produk yang dibeli adalah dukungan nyata bagi pertumbuhan ekonomi lokal.</h2>
          </div>
          <a class="inline-flex min-h-12 items-center justify-center rounded-full bg-brand-500 px-6 py-3 font-semibold text-white shadow-lg shadow-brand-500/20 transition hover:bg-brand-600" href="/umkm">Temukan UMKM</a>
        </div>
      </div>
    </section>
  </main>

  <!-- ===== FOOTER ===== -->
  <%- include('partials/footer') %>
  
  <!-- ===== SCRIPT MOBILE NAV & FILTER ===== -->
  <script>
    const navToggle = document.querySelector('[data-nav-toggle]');
    const mobileNav = document.querySelector('[data-mobile-nav]');

    if (navToggle && mobileNav) {
      navToggle.addEventListener('click', () => {
        const isHidden = mobileNav.classList.contains('hidden');
        mobileNav.classList.toggle('hidden');
        navToggle.setAttribute('aria-expanded', String(isHidden));
      });

      mobileNav.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          mobileNav.classList.add('hidden');
          navToggle.setAttribute('aria-expanded', 'false');
        });
      });
    }

  </script>
</body>
</html>