<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#8b5a35">
  <title>
    <%= title %>
  </title>
  <link rel="icon" type="image/png" href="/images/LOGO TBA.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800;900&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/output.css">
</head>

<body class="bg-brand-50 font-sans text-stone-900 antialiased">

  <%- include('partials/header') %>

    <!-- MAIN -->
    <main class="mx-auto w-[min(100%-1.5rem,1180px)] flex-grow px-0 py-8 md:py-12">

      <!-- Page Header -->
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <span
            class="inline-flex items-center rounded-full bg-brand-500/10 px-3.5 py-1.5 text-xs font-bold tracking-wide text-brand-700">Katalog
            Usaha Nagari</span>
          <h1 class="mt-2 font-display text-3xl font-extrabold text-brand-900 sm:text-4xl">Daftar UMKM Nagari TBA</h1>
          <p class="mt-1 text-sm text-stone-500">Klik kartu untuk melihat profil lengkap, produk unggulan, dan kontak
            setiap usaha</p>
        </div>
        <p
          class="self-start sm:self-auto rounded-full bg-white/80 border border-brand-500/10 px-4 py-1.5 text-xs font-bold text-brand-700 shadow-sm">
          &gt; <%= umkmList.length %> UMKM Terdata</p>
      </div>

      <!-- UMKM Grid -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
        <% umkmList.forEach(function(u, index) { %>
          <article
            class="group flex cursor-pointer flex-col overflow-hidden rounded-2xl border border-brand-500/10 bg-[#FFFDF9] shadow-[0_4px_20px_rgba(0,0,0,0.04)] transition duration-300 hover:-translate-y-1.5 hover:shadow-soft"
            onclick="location.href='/umkm/<%= u.id %>'">
            <!-- Card Header / Visual Slot -->
            <div
              class="relative flex h-48 items-center justify-center overflow-hidden <%= getCardHeaderClass(index) %>">
              <span
                class="absolute left-4 top-4 z-10 rounded-full bg-black/30 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white backdrop-blur-sm">
                <%= u.badge || (u.bidang ? u.bidang.split(' ')[0] : ' UMKM') %>
              </span>

              <% if (u.fotoUtama) { %>
                <img src="<%= u.fotoUtama %>" alt="<%= u.nama %>"
                  class="h-full w-full object-cover object-center group-hover:scale-105 transition duration-500"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <span class="hidden text-6xl drop-shadow-sm">
                  <%= getIcon(u.bidang) %>
                </span>
                <% } else { %>
                  <span class="text-6xl drop-shadow-sm group-hover:scale-110 transition duration-300">
                    <%= getIcon(u.bidang) %>
                  </span>
                  <% } %>
            </div>

            <!-- Card Body -->
            <div class="flex flex-grow flex-col p-6">
              <h2 class="font-display text-xl font-bold text-brand-900 group-hover:text-brand-600 transition">
                <%= u.nama %>
              </h2>

              <p class="mt-1.5 flex items-center gap-1.5 text-xs text-stone-500">
                <svg class="h-3.5 w-3.5 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                  stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span>
                  <%= u.pemilik ? u.pemilik : 'Pelaku Usaha Nagari' %>
                </span>
              </p>

              <p class="mt-3 line-clamp-2 text-xs leading-relaxed text-stone-600">
                <%= u.deskripsi ? u.deskripsi : 'Usaha lokal binaan Nagari Tanjung Bonai Aur.' %>
              </p>

              <div class="mt-4 space-y-1.5 border-t border-stone-100 pt-3 text-[11px] font-medium text-stone-500">
                <% if (u.tahunBerdiri==='BELUM DIPASARKAN' ) { %>
                  <p class="flex items-center gap-1.5 font-semibold uppercase text-amber-700">
                    <svg class="h-3.5 w-3.5 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd"
                        d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                        clip-rule="evenodd" />
                    </svg>
                    Persiapan Legalitas
                  </p>
                  <% } else if (u.tahunBerdiri) { %>
                    <p class="flex items-center gap-1.5">
                      <svg class="h-3.5 w-3.5 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                        stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      Berdiri: <%= u.tahunBerdiri %>
                    </p>
                    <% } else if (u.tahun) { %>
                      <p class="flex items-center gap-1.5">
                        <svg class="h-3.5 w-3.5 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                          stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round"
                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        Berdiri: <%= u.tahun %>
                      </p>
                      <% } else { %>
                        <p class="flex items-center gap-1.5 text-stone-400">
                          <svg class="h-3.5 w-3.5 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                            stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                          </svg>
                          Tahun belum tercatat
                        </p>
                        <% } %>

                          <p class="flex items-center gap-1.5">
                            <svg class="h-3.5 w-3.5 text-stone-400" fill="none" viewBox="0 0 24 24"
                              stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round"
                                d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                            </svg>
                            <%= u.bidang ? u.bidang : 'Usaha Nagari' %>
                          </p>
              </div>

              <p class="mt-4 font-extrabold text-sm text-brand-700">
                <% if (u.hargaDisplay) { %>
                  <%= u.hargaDisplay %>
                    <% } else if (u.hargaDari) { %>
                      Rp <%= formatRupiah(u.hargaDari) %>
                        <% if (u.hargaSampai) { %> - <%= formatRupiah(u.hargaSampai) %>
                            <% } %>
                              <% } else { %>
                                Sesuai Pesanan
                                <% } %>
              </p>
            </div>
          </article>
          <% }); %>
      </div>
    </main>

    <!-- FOOTER -->
    <%- include('partials/footer') %>

      <!-- SCRIPT MOBILE NAV & FILTER -->
      <script>
        const navToggle = document.querySelector('[data-nav-toggle]');
        const mobileNav = document.querySelector('[data-mobile-nav]');

        if (navToggle && mobileNav) {
          navToggle.addEventListener('click', () => {
            const isHidden = mobileNav.classList.contains('hidden');
            mobileNav.classList.toggle('hidden');
            navToggle.setAttribute('aria-expanded', String(isHidden));
          });

          mobileNav.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => {
              mobileNav.classList.add('hidden');
              navToggle.setAttribute('aria-expanded', 'false');
            });
          });
        }
      </script>
</body>

</html>