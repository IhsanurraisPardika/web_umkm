// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ENUM

enum StatusPersetujuan {
  BERSEDIA
  TIDAK_BERSEDIA
  BELUM_DIISI
}

enum PlatformSosialMedia {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  MARKETPLACE
  LAINNYA
}

enum JenisFoto {
  PEMILIK
  TEMPAT_USAHA
  PRODUK_UNGGULAN
  PROSES_PRODUKSI
  LAINNYA
}


// ======================================================
// PEMILIK UMKM
// ======================================================

model Pemilik {
  id        Int      @id @default(autoincrement())
  nama      String   @db.VarChar(191)
  whatsapp  String?  @db.VarChar(30)

  umkm      Umkm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nama])
  @@map("pemilik")
}


// ======================================================
// KATEGORI UMKM
// ======================================================

model Kategori {
  id        Int      @id @default(autoincrement())
  nama      String   @unique @db.VarChar(191)
  slug      String   @unique @db.VarChar(191)

  umkm      Umkm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kategori")
}


// ======================================================
// DATA UTAMA UMKM
// ======================================================

model Umkm {
  id                    Int                @id @default(autoincrement())

  nomorData             Int?               @unique

  namaUmkm              String             @db.VarChar(191)
  slug                  String             @unique @db.VarChar(191)
  alamatUsaha           String             @db.Text

  // ==================================================
  // PEMILIK
  // ==================================================

  pemilikId             Int
  pemilik               Pemilik            @relation(fields: [pemilikId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // ==================================================
  // KATEGORI
  // ==================================================

  kategoriId            Int?
  kategori              Kategori?          @relation(fields: [kategoriId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // ==================================================
  // INFORMASI USAHA
  // ==================================================

  tahunBerdiri           Int?
  informasiTahunBerdiri String?            @db.VarChar(191)

  deskripsi              String?            @db.LongText

  produkUtama            String?            @db.Text
  produkFavorit          String?            @db.Text

  hargaMinimum           Int?
  hargaMaksimum          Int?
  keteranganHarga        String?            @db.Text

  jamOperasional         String?            @db.VarChar(191)

  // ==================================================
  // PEMASARAN
  // ==================================================

  metodePemasaran        String?            @db.Text
  punyaSosialMedia       Boolean?

  // ==================================================
  // LOKASI
  // ==================================================

  googleMapsUrl          String?            @db.Text
  titikLokasi            String?            @db.Text

  latitude               Decimal?           @db.Decimal(10, 7)
  longitude              Decimal?           @db.Decimal(10, 7)

  // ==================================================
  // PERSETUJUAN WEBSITE
  // ==================================================

  statusPersetujuan      StatusPersetujuan  @default(BELUM_DIISI)
  tampilDiWebsite        Boolean            @default(false)

  catatan                String?            @db.LongText

  // ==================================================
  // RELASI
  // ==================================================

  sosialMedia            SosialMedia[]
  foto                   FotoUmkm[]

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([namaUmkm])
  @@index([pemilikId])
  @@index([kategoriId])
  @@index([tampilDiWebsite])

  @@map("umkm")
}


// ======================================================
// SOSIAL MEDIA UMKM
// ======================================================

model SosialMedia {
  id        Int                  @id @default(autoincrement())

  umkmId    Int
  platform  PlatformSosialMedia

  username  String?              @db.VarChar(191)
  url       String?              @db.Text

  umkm      Umkm                 @relation(fields: [umkmId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([umkmId, platform])
  @@index([umkmId])

  @@map("sosial_media")
}


// ======================================================
// FOTO UMKM
// ======================================================

model FotoUmkm {
  id        Int        @id @default(autoincrement())

  umkmId    Int
  jenis     JenisFoto

  url       String     @db.Text

  altText   String?    @db.VarChar(255)
  caption   String?    @db.VarChar(255)

  fotoUtama Boolean    @default(false)
  urutan    Int        @default(0)

  umkm      Umkm       @relation(fields: [umkmId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([umkmId])
  @@index([umkmId, jenis])

  @@map("foto_umkm")
}